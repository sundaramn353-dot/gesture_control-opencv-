<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="gesture_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Realistic Environment Scene & Lighting -->
    <scene>
      <ambient>0.6 0.6 0.65 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>true</grid>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>5 5 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 -0.5 -1.0</direction>
    </light>

    <!-- Realistic Ground Plane (Slate Industrial Floor) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.25 0.28 0.32 1</ambient>
            <diffuse>0.3 0.33 0.38 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room Boundary Walls (14m x 14m Room) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 7 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14 0.2 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>14 0.2 1.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -7 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>14 0.2 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>14 0.2 1.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>7 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 14 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 14 1.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-7 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 14 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 14 1.5</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Realistic Furniture & Obstacles -->
    <!-- Wooden Crate 1 -->
    <model name="crate_1">
      <pose>2.5 2.0 0.4 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wooden Crate 2 -->
    <model name="crate_2">
      <pose>-2.5 3.0 0.5 0 0 -0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.5 0.3 0.12 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Wooden Crate Stack 3 -->
    <model name="crate_3">
      <pose>-2.5 -2.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 1.2 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 1.2 0.8</size></box></geometry>
          <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Lab Workbench / Desk -->
    <model name="desk_1">
      <static>true</static>
      <pose>3.0 -3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.9 0.8</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.8 0.9 0.8</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Safety Pillars / Cylinders -->
    <model name="pillar_1">
      <static>true</static>
      <pose>1.5 -1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-1.5 1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>